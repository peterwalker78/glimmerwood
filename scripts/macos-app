#!/usr/bin/env bash
# Wrap the macOS binary in the folder layout macOS calls an application.
# Unsigned, and deliberately: notarising needs a paid Apple account, and the
# way round that is to build from source rather than to pay for a signature.
set -euo pipefail
binary=$1
app=$2

mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
cp "$binary" "$app/Contents/MacOS/Glimmerwood"
chmod +x "$app/Contents/MacOS/Glimmerwood"

cat > "$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>Glimmerwood</string>
  <key>CFBundleDisplayName</key><string>Glimmerwood</string>
  <key>CFBundleExecutable</key><string>Glimmerwood</string>
  <key>CFBundleIdentifier</key><string>io.github.peterwalker78.Glimmerwood</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>${VERSION:-0.4.0}</string>
  <key>CFBundleVersion</key><string>${VERSION:-0.4.0}</string>
  <key>LSMinimumSystemVersion</key><string>11.0</string>
  <key>NSHighResolutionCapable</key><true/>
</dict>
</plist>
PLIST

echo "macos-app: built $app"
