[Desktop Entry]
Type=Application
Name=Wisp
GenericName=Web Browser
Comment=A quiet browser with a living companion
Exec=wisp %U
Icon=io.github.peterwalker78.Wisp
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
Keywords=web;internet;browser;
StartupNotify=true
StartupWMClass=io.github.peterwalker78.Wisp
